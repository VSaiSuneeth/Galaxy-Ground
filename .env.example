# Copy to `.env` and fill with values from Supabase Dashboard → Project Settings → API
# Never commit `.env`.

VITE_SUPABASE_URL=https://lmdswaagcdxulcczkqmu.supabase.co
# New format (recommended):
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy alias (also supported by the app):
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
# API_BASE_URL=http://localhost:20128/v1
# E2E_USER_A_EMAIL=your-test-user-a@example.com
# E2E_USER_A_PASSWORD=your-test-user-a-password
# E2E_USER_B_EMAIL=your-test-user-b@example.com
# E2E_USER_B_PASSWORD=your-test-user-b-password
# E2E_ADMIN_EMAIL=your-test-admin@example.com
# E2E_ADMIN_PASSWORD=your-test-admin-password
# E2E_ALLOW_MUTATIONS=false

# Edge Function secrets (set with `supabase secrets set`; never put real values here)
# CRON_SECRET=your-cron-secret
# SITE_ORIGIN=https://your-production-site.example
# OPENAI_API_KEY=your-openai-key
# FIRECRAWL_API_KEY=your-firecrawl-key
# RESEND_API_KEY=your-resend-key
# EMAIL_FROM_ADDRESS=notifications@your-domain.example
# NASA_API_KEY=your-nasa-key
# LAUNCHES_API_URL=https://your-launch-provider.example/api
# LAUNCHES_API_KEY=your-launch-provider-key
# TOPICS_API_URL=https://your-topics-provider.example/api
# TOPICS_API_KEY=your-topics-provider-key
# Optional: only if your app reads it (not required by src/integrations/supabase/client.ts)
# VITE_SUPABASE_PROJECT_ID=your_project_ref
# VITE_ALLOW_FALLBACK_DATA=true
VITE_SITE_URL=https://your-production-site.example
VITE_GTM_ID=GTM-XXXXXXX
VITE_GOOGLE_SITE_VERIFICATION=your-google-search-console-token
